# Kopieren nach .env.local und Werte eintragen. .env.local wird nie committet.

# Mistral La Plateforme (EU). Schlüssel: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Modellwahl per Umgebungsvariable (Stand und Begründung: siehe README)
MISTRAL_MODEL_CHAT=
MISTRAL_MODEL_FAST=
MISTRAL_MODEL_EMBED=mistral-embed

# SV-Box (Nextcloud) der KI Challenge: Token und Passwort je Share (Werte stehen auf dem SV-Box-Blatt)
SVBOX_BASE_URL=https://dvsv.svbox.at
SVBOX_UC3_TOKEN=
SVBOX_UC3_PW=
# Veranstalter-Modell, Azure AI Foundry (OpenAI-kompatibel)
AZURE_OPENAI_BASE_URL=https://aif-dvsv-dev-hackathon-01-we-01.services.ai.azure.com/openai/v1
AZURE_OPENAI_MODEL=gpt-5-4-mini
AZURE_API_KEY=
