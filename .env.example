# Kopieren nach .env.local an der Repo-Wurzel und Werte eintragen.
# .env.local wird nie committet: das Abgabe-Repo ist öffentlich.
# Python-CLIs laden die Datei beim Start (plattform.umgebung, sucht aufwärts, in einem Git-Worktree auch im Hauptordner des Repos),
# web/ über dotenv-cli. Nur VAPI_PUBLIC_KEY geht als NEXT_PUBLIC_VAPI_PUBLIC_KEY in den Browser.

# Modell-Schalter plattform.llm: azure | claude | mistral | ollama | mock
LLM_PROVIDER=azure
# Höchstzahl Modellaufrufe je UTC-Tag über alle Prozesse (gezählt im Modellprotokoll), leer = kein Budget (lokal)
LLM_TAGESBUDGET_AUFRUFE=
# Höchstzahl Fragen je Client-IP und Minute an POST /api/uc4/frage (Web-App, im Speicher)
RATENLIMIT_PRO_MINUTE=10

# Veranstalter-Modell, Azure AI Foundry (OpenAI-kompatibel), Standard und Pflicht für UC3-Agenten.
# Adresse vom Veranstalter (Ressource in West Europe, „we-16“), Form: https://<ressource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_MODEL=gpt-5-4-mini
AZURE_API_KEY=

# Claude per `claude -p` (Abo, kein API-Schlüssel), nur UC1/UC2-Qualitätsmodus und Vergleiche
CLAUDE_MODEL=claude-opus-5-5

# Mistral La Plateforme (EU), Zweitanbieter für den Live-Austausch. Schlüssel: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL_CHAT=
MISTRAL_MODEL_FAST=

# Ollama, Offline-Notnagel (lokaler Rechner)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Datenbanken je UC, alle auf PostgreSQL 5433 (damit ein Postgres auf 5432 nicht stört)
UC1_DATABASE_URL=postgresql://lotse:lotse@localhost:5433/lotse
UC2_DATABASE_URL=postgresql://statistik:statistik@localhost:5433/healthpolicy
UC3_DATABASE_URL=postgresql://statistik:statistik@localhost:5433/statistik
# Optional UC3: Ordner des Startpakets (Standard ../svbox/uc3) und Ziel der Abgabe-Dateien (Standard abgabe/)
# STATAGENT_STARTPAKET=
# STATAGENT_ABGABE=
# Optional: Ort des Modellprotokolls (Standard var/protokoll/modellaufrufe.jsonl an der Repo-Wurzel)
# PLATTFORM_PROTOKOLL=
# UC1: Ordner mit dem Datenpaket des Veranstalters (svbox/uc1); ohne ihn brechen Befehle ab, die es lesen
# UC1_DATA_DIR=
# Optional UC2: Ablage außerhalb des Repos für Presse, Daten und Zwischenstände (Standard siehe uc2/README.md).
# Nicht leer setzen: Ein leerer Wert zeigt auf den aktuellen Ordner.
# KIC_ABLAGE=

# UC4 Gemeinsamer Einstieg (POST /api/uc4/frage): mock = Mock-Adapter des Routers für CI und die Online-Demo ohne
# Modellschlüssel; leer = Adapter aus Registry und Entry-Points
UC4_ADAPTER=
# Stationen als Komma-Liste aus uc3,uc2,uc1. Leer: lokal alle drei, online (KIC_ONLINE=1) nur uc3
# UC4_KETTE=
# Nur online (KIC_ONLINE=1): Anbieter, die man auf /uc4 wählen darf, Komma-Liste (z. B. azure,mistral); leer = nur Testbetrieb
UC4_MODELLWAHL=
# 1 = Online-Demo nur lesend: POST /api/uc4/frage antwortet 403, solange das Ratenlimit fehlt (#100)
KIC_ONLINE_LESEND=
# 1 = die Frage-Wege bleiben auch bei KIC_ONLINE_LESEND=1 offen, alles andere bleibt gesperrt
# KIC_ONLINE_FRAGEN=
# 1 = online (setzt nur deploy/docker-compose.prod.yml): echte Modelle nur mit LLM_TAGESBUDGET_AUFRUFE (#100)
KIC_ONLINE=

# Voice (Vapi, US-Dienst; Datenfluss siehe docs/voice.md)
# Privater Schlüssel der Vapi-API, nur für `python -m plattform.voice sync`
VAPI_API_KEY=
# Öffentlicher Schlüssel für den VoiceKnopf im Browser (NEXT_PUBLIC_VAPI_PUBLIC_KEY)
VAPI_PUBLIC_KEY=
# Vapi schickt ihn als x-vapi-secret an /vapi/webhook; `sync` trägt ihn im Assistant ein
VAPI_WEBHOOK_SECRET=
# Vapi schickt ihn als Authorization: Bearer an /chat/completions; `sync` überträgt ihn nicht, in Vapi von Hand hinterlegen
VAPI_CUSTOM_LLM_KEY=
# ID des Vapi-Assistants für sync und smoke; leer: `sync` legt einen neuen an
VAPI_ASSISTANT_ID=
# Öffentliche Adresse der UC-FastAPI (cloudflared-Tunnel)
PUBLIC_URL=
# Optional: Ziel der Anrufende-Zeilen, Standard voice.jsonl neben modellaufrufe.jsonl
# PLATTFORM_VOICE_PROTOKOLL=
# Optional: gültige /chat/completions je Client-IP und Minute (Standard 30)
# VOICE_RATENLIMIT_PRO_MINUTE=30
# Optional: Frist der UC-Antwort in Sekunden, danach 504 (Standard 20)
# VOICE_ANTWORT_TIMEOUT_S=20
