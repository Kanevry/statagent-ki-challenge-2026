# Kopieren nach .env.local und Werte eintragen. .env.local wird nie committet.

# Mistral La Plateforme (EU). Schlüssel: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Modellwahl per Umgebungsvariable (Stand und Begründung: siehe README)
MISTRAL_MODEL_CHAT=
MISTRAL_MODEL_FAST=
MISTRAL_MODEL_EMBED=mistral-embed
