{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uc2/akteure/zug.schema.json",
  "title": "Zug eines Akteurs in einer Verhandlungsrunde",
  "description": "Antwort eines Akteurs je Runde. Zahlen nur mit Quelle `experte` oder einer Beleg-ID.",
  "type": "object",
  "additionalProperties": false,
  "required": ["themen", "bezug_auf", "zahlen"],
  "properties": {
    "themen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["thema", "haltung", "begruendung", "beleg_ids", "bedingungen", "zugestaendnis"],
        "properties": {
          "thema": {"type": "string", "minLength": 1},
          "haltung": {
            "description": "-2 strikt dagegen, -1 dagegen, 0 enthalten, +1 dafür, +2 strikt dafür.",
            "type": "integer",
            "minimum": -2,
            "maximum": 2
          },
          "begruendung": {"type": "string", "minLength": 1},
          "beleg_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/beleg_id"}},
          "bedingungen": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "zugestaendnis": {
            "description": "Zugeständnis in dieser Runde; null oder leer, wenn keines.",
            "type": ["string", "null"]
          }
        }
      }
    },
    "bezug_auf": {
      "description": "IDs anderer Teilnehmer, auf die der Zug eingeht (ab Runde 2 mindestens einer).",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z_]*$"}
    },
    "zahlen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wert", "einheit", "quelle"],
        "properties": {
          "wert": {"type": "number"},
          "einheit": {"type": "string", "minLength": 1},
          "quelle": {
            "description": "`experte` oder eine Beleg-ID.",
            "anyOf": [{"const": "experte"}, {"$ref": "#/$defs/beleg_id"}]
          }
        }
      }
    }
  },
  "$defs": {
    "beleg_id": {
      "description": "Abschnitt-ID `<md5[:12]>-<artikelnr:03d>-<abschnittnr:02d>` oder Artikel-ID ohne den letzten Teil (#40).",
      "type": "string",
      "pattern": "^[0-9a-f]{12}-[0-9]{3}(-[0-9]{2})?$"
    }
  }
}
