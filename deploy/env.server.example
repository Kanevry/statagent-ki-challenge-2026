# Vorlage für <basis>/.env.server auf dem Server (nur für den Deploy-Nutzer lesbar).
# Nur Schlüsselnamen, nie Werte committen. Werte in einfache Anführungszeichen setzen, wenn sie "$" enthalten:
# Compose ersetzt in doppelten oder fehlenden Anführungszeichen "$..." durch Variablen.

# Öffentliche Adresse der Demo (Caddy holt dafür das Zertifikat)
SITE_ADDRESS=
# Inhalt: platzhalter (statische Seite) | app (Next.js-Web). Auf app, sobald die Landingpage (#58) auf main ist.
INHALT=platzhalter

# Datenbank-Passwörter (je 32 Zeichen, nur intern); schreibt `scripts/deploy.sh init`.
# POSTGRES_PASSWORD gehört dem Superuser statistik (nur Admin), KIC_APP_DB_PASSWORD der Rolle kic_app (nur lesen).
POSTGRES_PASSWORD=
KIC_APP_DB_PASSWORD=

# Pflicht (#100): höchstens so viele Modellaufrufe je Tag (UTC), ganze Zahl ab 1; ohne Wert startet die App nicht.
# Das Protokoll muss beschreibbar sein (Volume für PLATTFORM_PROTOKOLL), sonst lehnt plattform.llm jeden Aufruf ab.
LLM_TAGESBUDGET_AUFRUFE=
# Optional: Pfad des Modellprotokolls im Volume app_protokoll (Standard /app/var/protokoll/modellaufrufe.jsonl)
# PLATTFORM_PROTOKOLL=

# Online-Fragen (Lead 05.11.2026). Stufe A ohne Modell: KIC_ONLINE_FRAGEN=1, UC4_KETTE=uc3 (Standard).
# Stufe B mit Modell: zusätzlich UC4_KETTE leer setzen (UC4_KETTE=""), LLM_PROVIDER und Schlüssel unten,
# UC4_MODELLWAHL=azure und ein bewusst gewähltes LLM_TAGESBUDGET_AUFRUFE (eine /uc4-Frage: rund 5 Aufrufe).
# KIC_ONLINE_FRAGEN=
# UC4_KETTE=uc3
# UC4_MODELLWAHL=
# RATENLIMIT_PRO_MINUTE=

# Modellzugänge für den app-Container. Provider claude und ollama sind online aus; ohne Eintrag gilt mock.
# Erst eintragen, wenn Ratenlimit und Tagesbudget stehen: die Seite ist ohne Passwort erreichbar.
# LLM_PROVIDER=azure
# AZURE_OPENAI_BASE_URL=
# AZURE_OPENAI_MODEL=
# AZURE_API_KEY=
# MISTRAL_API_KEY=
# MISTRAL_BASE_URL=
# MISTRAL_MODEL_CHAT=
# MISTRAL_MODEL_FAST=
# VAPI_API_KEY=
# VAPI_PUBLIC_KEY=
# VAPI_WEBHOOK_SECRET=
# VAPI_CUSTOM_LLM_KEY=
# VAPI_ASSISTANT_ID=
